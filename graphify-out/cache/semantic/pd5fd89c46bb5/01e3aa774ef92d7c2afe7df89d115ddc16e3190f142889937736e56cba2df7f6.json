{"nodes": [{"id": "project_plan_license_controller", "label": "License Controller", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a72, \u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides what is allowed (allocation, leases, policy, reconciliation, audit) across an org-wide pool of core entitlements."}, {"id": "project_plan_kms_host", "label": "KMS Host (Activation Authority)", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a72, \u00a75.5, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides what is activated via Volume Activation Services role with customer CSVLK. Configured, not built."}, {"id": "project_plan_hypervisor_cloud_platform", "label": "Hypervisor / Cloud Platform", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a72, \u00a73, \u00a74, \u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decides what is actually running; independent private cloud infrastructure exposing VM power-state / control-plane API."}, {"id": "project_plan_tripartite_authority_principle", "label": "Tripartite Authority Principle", "file_type": "rationale", "source_file": "Project_Plan.md", "source_location": "\u00a70 Core Principle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "License Controller decides what is allowed; KMS decides what is activated; Hypervisor decides what is actually running. None must stand in for another."}, {"id": "project_plan_flexible_virtualization_benefit", "label": "Flexible Virtualization Benefit (FVB)", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Microsoft licensing foundation enabling dynamic core allocation to Windows Server Standard VMs on authorized non-listed infrastructure."}, {"id": "project_plan_fvb_legal_eligibility", "label": "FVB Legal Eligibility Conditions", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires active SA/subscription, non-Listed Provider host, same server farm, 8-core minimum per VM, 16-core customer floor."}, {"id": "project_plan_written_reseller_confirmation", "label": "Written Microsoft / Reseller Confirmation", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a71, \u00a710", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest-priority open action: legal confirmation must be obtained in writing before production reliance."}, {"id": "project_plan_vm_agent", "label": "VM Agent", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a72, \u00a75.1, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows Service on target VMs. Connects outbound-only to controller, heartbeats, caches locally, queries activation without touching license keys."}, {"id": "project_plan_windows_server_2025_vm", "label": "Windows Server 2025 Standard VM", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a70, \u00a71, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardized target OS edition with 8-core minimum allocation, KMS GVLK configured."}, {"id": "project_plan_mtls_transport", "label": "Outbound HTTPS / mTLS Transport", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a72, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent-initiated outbound-only transport; requires no open inbound ports on guest VMs."}, {"id": "project_plan_enforcement_tier_1", "label": "Tier 1: Pre-Boot Admission Control", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred enforcement mechanism: controller gates platform VM start requests directly, ensuring true prevention."}, {"id": "project_plan_enforcement_tier_2", "label": "Tier 2: Platform RBAC Gating", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Practical fallback: platform VM start rights restricted to controller service account; human starts route via controller."}, {"id": "project_plan_enforcement_tier_3", "label": "Tier 3: Detection & Alerting", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimum viable stopgap: reconciliation detects unauthorized running VM within minutes and fires alerts."}, {"id": "project_plan_vm_state_detection_model", "label": "VM State Detection Model", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six discrete states (RUNNING, STOPPING, STOPPED, TERMINATED, UNREACHABLE, UNKNOWN) governing lease reservation and release."}, {"id": "project_plan_unreachable_state_policy", "label": "Unreachable State Policy", "file_type": "rationale", "source_file": "Project_Plan.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strict policy: heartbeat loss without authoritative hypervisor confirmation does NOT auto-release, preventing over-allocation during network disconnects."}, {"id": "project_plan_controller_api", "label": "Controller API (FastAPI)", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a75.2, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FastAPI service exposing idempotent endpoints for allocation, lease management, and policy enforcement."}, {"id": "project_plan_reconciliation_engine", "label": "Reconciliation Engine", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a75.4, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First-class background subsystem comparing expected leases vs actual hypervisor running state on schedule."}, {"id": "project_plan_postgresql_state_store", "label": "PostgreSQL State Store", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a75.3, \u00a76, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Relational state backend using SQLAlchemy + Alembic, storing entitlements, vms, leases, and audit_log."}, {"id": "project_plan_append_only_audit_log", "label": "Append-Only Audit Log", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a75.7, \u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Immutable compliance trail recording all allocate, release, reconciliation, and enforcement events with timestamp and actor."}, {"id": "project_plan_management_dashboard", "label": "Management Dashboard (React)", "file_type": "concept", "source_file": "Project_Plan.md", "source_location": "\u00a75.6, \u00a77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React + REST UI for monitoring capacity; strictly off the licensing-critical execution path."}, {"id": "project_plan_idempotent_request_key", "label": "Idempotent Request Key (request_id)", "file_type": "conce